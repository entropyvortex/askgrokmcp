{
  "name": "askgrok",
  "displayName": "Ask Grok",
  "version": "1.6.0",
  "description": "Ask Grok and generate images with Imagine through the grok CLI, using your Grok subscription.",
  "author": {
    "name": "Marcelo Ceccon",
    "url": "https://github.com/marceloceccon"
  },
  "homepage": "https://github.com/marceloceccon/askgrokmcp",
  "repository": "https://github.com/marceloceccon/askgrokmcp",
  "license": "MIT",
  "keywords": ["grok", "xai", "imagine", "mcp"],
  "mcpServers": {
    "grok": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/bin/plugin-start.mjs"],
      "env": {
        "GROK_BACKEND": "cli"
      }
    }
  }
}
